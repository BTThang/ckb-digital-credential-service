# ---------------------------------------------------------------------------
# CKB Digital Credential - backend service environment
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000
HOST=127.0.0.1

# Comma separated list of allowed browser origins (the Vite dev server origin)
# These must match VITE_API_BASE_URL's host, otherwise a SameSite=Strict cookie
# is treated as cross-site and the browser silently drops it. Use `localhost` on
# both sides for local development.
#
# Both loopback spellings are listed on purpose: a browser may resolve
# `localhost` to either 127.0.0.1 or ::1, and whichever it picks is what lands
# in the Origin header. An origin left out of this list is answered without
# `Access-Control-Allow-Origin`, which the page can only show as "Failed to
# fetch" - the browser deliberately hides the real reason.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# CKB network used by the read-only RPC client.
#   testnet | mainnet
CKB_NETWORK=testnet

# Optional: override the public CKB RPC endpoint(s).
# Leave empty to use the official public endpoints bundled with CCC.
# Multiple URLs can be separated by commas (the client will fail over).
CKB_RPC_URL=

# SQLite database file (relative paths are resolved from the project root).
DATABASE_FILE=./data/credentials.db

# Log level: error | warn | info | debug
LOG_LEVEL=info

# --- Wallet authentication ----------------------------------------------------
# Name shown in the "Sign in to ..." message the wallet asks the user to sign.
AUTH_APP_NAME=CKB Digital Credential

# Lifetime of a sign-in challenge. Short by design: the user signs immediately.
AUTH_NONCE_TTL_MINUTES=5

# Lifetime of the session cookie (default 7 days).
SESSION_TTL_MINUTES=10080

# Cookie name. Leave empty for `__Host-ckb_session` when the cookie is secure
# and `ckb_session` otherwise.
SESSION_COOKIE_NAME=

# `Secure` attribute. Empty = on in production only. Local HTTP needs it off.
SESSION_COOKIE_SECURE=

# strict | lax | none. `none` additionally requires SESSION_COOKIE_SECURE=true.
# Keep `strict` and serve the frontend from the same host as the API.
SESSION_COOKIE_SAME_SITE=strict

# JoyID credential server, e.g. the JoyID API for the network above. Used to
# prove that a JoyID public key controls the claimed CKB address, because a
# JoyID signature on its own only proves control of the submitted public key.
# There is deliberately no default: leave it empty and JoyID sign-in is
# refused (other CKB wallets keep working). Take the value from your JoyID
# deployment - see https://docs.joy.id
JOYID_CREDENTIAL_SERVER_URL=
